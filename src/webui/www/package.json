{
  "name": "webui",
  "description": "qBittorrent WebUI",
  "repository": {
    "type": "git",
    "url": "https://github.com/BoKu/Bitarr.git"
  },
  "scripts": {
    "format": "js-beautify -r *.mjs private/*.html private/js/*.js public/*.html public/js/*.js && prettier --write **.css",
    "lint": "eslint --cache *.mjs private/*.html private/js/*.js public/*.html public/js/*.js && stylelint --cache **/*.css && html-validate private public",
    "test": "echo \"no unit tests yet\""
  },
  "devDependencies": {
    "@eslint/js": "*",
    "@stylistic/eslint-plugin": "*",
    "eslint": "*",
    "eslint-plugin-html": "*",
    "eslint-plugin-prefer-arrow-functions": "*",
    "eslint-plugin-qbt-webui": "https://github.com/Chocobo1/eslint-plugin-qbt-webui/tarball/v1",
    "eslint-plugin-regexp": "*",
    "eslint-plugin-unicorn": "*",
    "happy-dom": "*",
    "html-validate": "*",
    "js-beautify": "*",
    "prettier": "*",
    "stylelint": "*",
    "stylelint-config-standard": "*",
    "stylelint-order": "*",
    "vitest": "*"
  }
}
